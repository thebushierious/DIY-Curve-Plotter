		(uuid "665cb65c-1fe1-4fcf-bc00-5dd8bd4b6e6c")
	)
	(text "V-Supply Voltage\nVc-Coil Voltage\nI-Supply Curren\nIc-Coil Current\nIb-Base Current\nR-Colector Reistance\nRc-Coil Resistance\nR_{40}-R40 Resistance\nR_{41}-R41 Resistance\nW_{R40}-R_{40} Power\nW_{R41}-R_{41} Power\nnK-Number of Relays"
