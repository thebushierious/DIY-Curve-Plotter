	(text "For any number of relays:\nR_{40} = ^{V}/_{Ic*nK} - ^{Rc}/_{nK}\nIc = ^{Vc}/_{Rc}\n\nI = ^{V}/_{R}\nR = R_{40} + ^{Rc}/_{nK}\n\nR_{41} = ^{V}/_{Ib}\nIb = ^{I}/_{10}\n\nW_{R40} = R_{40} * I^{2}\nW_{R41} = R_{41} * Ib^{2}"
		(exclude_from_sim no)
		(at 121.158 121.92 0)
		(effects
