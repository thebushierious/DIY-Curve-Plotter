	(text "Calculate R41"
		(exclude_from_sim no)
		(at 65.024 54.864 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "319cc7fd-368c-480e-a613-3cb8541d0a1f")
	)
	(text "For any number of relays:\nI = ^{Vc}/_{R}\nI = Ic1 + Ic2 + ...\nR = (^{1}/_{Rc1} + ^{1}/_{Rc2} + ...)^{-1}\n\nR_{41} = ^{Vs - Vbe}/_{Ib + Vbe/R58}\nIb = ^{Ic}/_{10}\n\nW_{R41} = R_{41} * I_{41}^{2}\nI_{41} = Ib + ^{Vbe}/_{R58}"
		(exclude_from_sim no)
		(at 98.552 80.264 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "665cb65c-1fe1-4fcf-bc00-5dd8bd4b6e6c")
	)
	(text "Vc - Coil Voltage\nVs - Switch Voltage\nVbe - Base-Emitter Volage\nI - Collector Curren\nIc - Coil Current\nI_{R41} - R41 Current\nIb - Base Current\nR - Collector Resistance\nRc - Coil Resistance\nR_{41} - R41 Resistance\nW_{R41} - R_{41} Power"
		(exclude_from_sim no)
		(at 40.132 79.756 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "78bdb053-6b1c-4036-8786-9eab94904bb8")
	)
	(text "D7 - D9 1N4148"
		(exclude_from_sim no)
		(at 78.232 32.004 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d3155d76-3e68-41fa-b0b0-15e80ebc8797")
	)
