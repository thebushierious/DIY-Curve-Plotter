							(font
								(size 1.27 1.27)
							)
						)
					)
				)
			)
			(embedded_fonts no)
		)
	)
	(text "For any number of relays:\nI = ^{Vc}/_{R}\nI = Ic1 + Ic2 + ...\nR = (^{1}/_{Rc1} + ^{1}/_{Rc2} + ...)^{-1}\n\nR_{41} = ^{Vs - Vbe}/_{Ib + Vbe/R58}\nIb = ^{I}/_{10}\n\nW_{R41} = R_{41} * I_{41}^{2}\nI_{41} = Ib + ^{Vbe}/_{R58}"
		(exclude_from_sim no)
		(at 103.378 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "665cb65c-1fe1-4fcf-bc00-5dd8bd4b6e6c")
	)
	(text "Vc - Coil Voltage\nVs - Switch Voltage\nVbe - Base-Emitter Volage\nI - Collector Curren\nIc - Coil Current\nI_{R41} - R41 Current\nIb - Base Current\nR - Collector Resistance\nRc - Coil Resistance\nR_{41} - R41 Resistance\nW_{R41} - R_{41} Power"
		(exclude_from_sim no)
		(at 39.624 82.804 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "78bdb053-6b1c-4036-8786-9eab94904bb8")
	)
