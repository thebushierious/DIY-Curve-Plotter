	(text "For any number of relays:\nR_{40} = ^{V}/_{IC} - (^{1}/_{Rc1} + ^{1}/_{Rc2} + ...)^{-1}\nIc = ^{Vc}/_{Rc}\nIC = Ic1 + Ic2 + ...\n\nI = ^{V}/_{R}\nR = R_{40} + (^{1}/_{Rc1} + ^{1}/_{Rc2} + ...)^{-1}\n\nR_{41} = ^{V}/_{Ib}\nIb = ^{I}/_{10}\n\nW_{R40} = R_{40} * I^{2}\nW_{R41} = R_{41} * Ib^{2}"
		(exclude_from_sim no)
		(at 118.11 126.238 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "665cb65c-1fe1-4fcf-bc00-5dd8bd4b6e6c")
	)
	(text "V-Supply Voltage\nVc-Coil Voltage\nI-Supply Curren\nIc-Coil Current\nIC-Total Coil Current\nIb-Base Current\nR-Colector Reistance\nRc-Coil Resistance\nR_{40}-R40 Resistance\nR_{41}-R41 Resistance\nW_{R40}-R_{40} Power\nW_{R41}-R_{41} Power\nnK-Number of Relays"
		(exclude_from_sim no)
		(at 112.776 73.66 0)
		(effects
